<p>
  <label><%= l(:label_scheduler_vroom_url) %></label>
  <%= text_field_tag 'settings[vroom_url]', RedmineGttScheduler.settings['vroom_url'], size: 60 %>
  <em class="info"><%= l(:text_scheduler_vroom_url_hint) %></em>
</p>
<p>
  <label><%= l(:label_scheduler_default_service) %></label>
  <%= text_field_tag 'settings[default_service_minutes]', RedmineGttScheduler.settings['default_service_minutes'], size: 6 %>
  <em class="info"><%= l(:text_scheduler_default_service_hint) %></em>
</p>
<p>
  <label><%= l(:label_scheduler_timeout) %></label>
  <%= text_field_tag 'settings[solver_timeout]', RedmineGttScheduler.settings['solver_timeout'], size: 6 %>
</p>
<p>
  <label><%= l(:label_scheduler_skills_field) %></label>
  <%= select_tag 'settings[skills_custom_field_id]',
                 options_for_select(
                   [[l(:label_scheduler_skills_disabled), '']] +
                     IssueCustomField.where(field_format: 'list').sorted.map { |f| [f.name, f.id.to_s] },
                   RedmineGttScheduler.settings['skills_custom_field_id']
                 ) %>
  <em class="info"><%= l(:text_scheduler_skills_field_hint) %></em>
</p>
<p>
  <label><%= l(:label_scheduler_capacity_field) %></label>
  <%= select_tag 'settings[capacity_custom_field_id]',
                 options_for_select(
                   [[l(:label_scheduler_skills_disabled), '']] +
                     IssueCustomField.where(field_format: 'int').sorted.map { |f| [f.name, f.id.to_s] },
                   RedmineGttScheduler.settings['capacity_custom_field_id']
                 ) %>
  <em class="info"><%= l(:text_scheduler_capacity_field_hint) %></em>
</p>
<p>
  <label><%= l(:label_scheduler_request_geometry) %></label>
  <%= hidden_field_tag 'settings[request_geometry]', '0' %>
  <%= check_box_tag 'settings[request_geometry]', '1', RedmineGttScheduler.request_geometry? %>
  <em class="info"><%= l(:text_scheduler_request_geometry_hint) %></em>
</p>
