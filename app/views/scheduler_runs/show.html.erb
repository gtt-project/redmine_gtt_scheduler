<%= stylesheet_link_tag 'scheduler', plugin: 'redmine_gtt_scheduler' %>

<div class="contextual">
  <% if User.current.allowed_to?(:manage_scheduler, @project) && @run.proposed? %>
    <%= link_to l(:button_scheduler_apply), apply_project_scheduler_run_path(@project, @run),
                method: :post, class: 'icon icon-checked',
                data: {confirm: l(:text_scheduler_apply_confirm)} %>
  <% end %>
  <% if User.current.allowed_to?(:manage_scheduler, @project) && @run.discardable? %>
    <%= link_to l(:button_scheduler_discard), discard_project_scheduler_run_path(@project, @run),
                method: :post, class: 'icon icon-del' %>
  <% end %>
</div>

<h2><%= l(:label_scheduler_run) %> #<%= @run.id %></h2>

<p>
  <strong><%= l(:field_scheduled_on) %>:</strong> <%= format_date(@run.scheduled_on) %>
  &nbsp; <%= scheduler_run_status(@run) %>
</p>

<% if @run.failed? && @run.error_message.present? %>
  <div class="flash error"><%= @run.error_message %></div>
<% end %>

<% if @run.solving? || @run.draft? %>
  <p class="info"><%= l(:text_scheduler_run_in_progress) %></p>
<% end %>

<% if @route_geojson && @project.module_enabled?(:gtt) %>
  <fieldset id="location" class="collapsible">
    <legend onclick="toggleFieldset(this);" class="icon icon-expended"><%= l(:field_location) %></legend>
    <%= map_tag map: @project.map, geom: @route_geojson,
                popup: {href: '/issues/[id]'}, rotation: @project.map_rotation %>
    <p class="info"><%= l(:text_scheduler_map_straight_legs) %></p>
  </fieldset>
<% end %>

<% @assignments_by_resource.each_with_index do |(resource, assignments), index| %>
  <% color = RedmineGttScheduler::Scheduler::RouteGeoJson.color_for(index) %>
  <h3>
    <span class="scheduler-resource-swatch" style="background: <%= color %>"></span>
    <%= resource&.name %>
    <% if resource&.user %><span class="info">(<%= resource.user %>)</span><% end %>
  </h3>

  <%= render partial: 'timeline', locals: {assignments: assignments, color: color} %>

  <table class="list">
    <thead>
      <tr>
        <th>#</th>
        <th><%= l(:field_issue) %></th>
        <th><%= l(:field_start_time) %></th>
        <th><%= l(:field_due_time) %></th>
        <th><%= l(:label_scheduler_travel) %></th>
      </tr>
    </thead>
    <tbody>
      <% assignments.each do |assignment| %>
        <tr>
          <td><%= assignment.sequence %></td>
          <td><%= link_to_issue(assignment.issue) if assignment.issue %></td>
          <td><%= scheduler_time(assignment.starts_at) %></td>
          <td><%= scheduler_time(assignment.ends_at) %></td>
          <td><%= scheduler_travel(assignment.travel_seconds) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @unassigned_issues.any? %>
  <h3><%= l(:label_scheduler_unassigned) %></h3>
  <p class="info"><%= l(:text_scheduler_unassigned_reasons_are_local) %></p>
  <ul>
    <% @unassigned_issues.each do |issue| %>
      <li>
        <%= link_to_issue(issue) %>
        <span class="scheduler-diagnostic">
          &mdash; <%= l(:"text_scheduler_unassigned_#{@unassigned_reasons[issue.id] || :unknown}") %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>

<% if @run.excluded.any? %>
  <h3><%= l(:label_scheduler_excluded) %></h3>
  <ul>
    <% @run.excluded.each do |issue_id, reason| %>
      <li>
        <% if (issue = @excluded_issues[issue_id.to_i]) %>
          <%= link_to_issue(issue) %>
        <% else %>
          #<%= issue_id %>
        <% end %>
        (<%= l(:"text_scheduler_excluded_#{reason}", default: reason.to_s.humanize) %>)
      </li>
    <% end %>
  </ul>
<% end %>

<% if @run.resource_selection? %>
  <p class="info">
    <%= l(:text_scheduler_run_planned_with,
          resources: @run.selected_resources.sorted.map(&:name).join(', ')) %>
  </p>
<% end %>

<% html_title "#{l(:label_scheduler_run)} ##{@run.id}" %>
