<%= error_messages_for @resource %>
<div class="box tabular">
  <p><%= f.text_field :name, required: true, label: :field_name %></p>
  <p><%= f.select :user_id,
                  @project.users.sorted.map { |u| [u.name, u.id] },
                  {include_blank: true},
                  label: :field_user %></p>
  <p><%= f.text_field :start_lng, required: true, size: 12, label: :field_start_lng %></p>
  <p><%= f.text_field :start_lat, required: true, size: 12, label: :field_start_lat %></p>
  <p><%= f.text_field :end_lng, size: 12, label: :field_end_lng %></p>
  <p><%= f.text_field :end_lat, size: 12, label: :field_end_lat %></p>
  <p class="info"><%= l(:text_scheduler_resource_end_hint) %></p>
  <p><%= f.time_field :work_starts, label: :field_work_starts %></p>
  <p><%= f.time_field :work_ends, label: :field_work_ends %></p>
  <p>
    <label><%= l(:field_scheduler_working_days) %></label>
    <%# The hidden blank lets an all-unchecked form clear the list. %>
    <%= hidden_field_tag 'scheduler_resource[working_days][]', '' %>
    <%# date.day_names is Sunday-first, so ISO weekday d maps to d % 7. %>
    <% (1..7).each do |day| %>
      <label class="block">
        <%= check_box_tag 'scheduler_resource[working_days][]', day,
                          f.object.working_days.include?(day) %>
        <%= l(:'date.day_names')[day % 7] %>
      </label>
    <% end %>
    <em class="info"><%= l(:text_scheduler_working_days_hint) %></em>
  </p>
  <p><%= f.time_field :break_starts, label: :field_scheduler_break_starts %></p>
  <p><%= f.time_field :break_ends, label: :field_scheduler_break_ends %></p>
  <p>
    <%= f.number_field :break_minutes, min: 1, label: :field_scheduler_break_minutes %>
    <em class="info"><%= l(:text_scheduler_break_hint) %></em>
  </p>
  <% if RedmineGttScheduler.capacity_custom_field %>
    <p>
      <%= f.number_field :capacity, min: 0, label: :field_scheduler_capacity %>
      <em class="info"><%= l(:text_scheduler_capacity_hint) %></em>
    </p>
  <% end %>
  <% if (skills_field = RedmineGttScheduler.skills_custom_field) %>
    <p>
      <label><%= l(:field_scheduler_skills) %></label>
      <%# The hidden blank lets an all-unchecked form clear the list. %>
      <%= hidden_field_tag 'scheduler_resource[skills][]', '' %>
      <% skills_field.possible_values.each do |value| %>
        <label class="block">
          <%= check_box_tag 'scheduler_resource[skills][]', value,
                            f.object.skills.include?(value) %>
          <%= value %>
        </label>
      <% end %>
      <em class="info"><%= l(:text_scheduler_skills_hint, field: skills_field.name) %></em>
    </p>
  <% end %>
  <p><%= f.check_box :active, label: :field_active %></p>
</div>
